# ==============================================================================
# MedRule Phase 8 - Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to .env and customize values for your deployment environment.
# DO NOT commit real secrets or credentials to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment & Operational Mode
# ------------------------------------------------------------------------------
# Options: 'development' | 'staging' | 'production'
# In 'production': Dev login endpoints (/api/auth/dev-login) are strictly disabled
# and fail closed if a valid production OIDC Identity Provider is not configured.
MEDRULE_ENV=development

# ------------------------------------------------------------------------------
# 2. OpenID Connect (OIDC) Identity Provider (e.g., Keycloak, Okta, Authentik)
# ------------------------------------------------------------------------------
# Full base URL of the OIDC Issuer realm or authorization server
OIDC_ISSUER_URL=https://auth.example.com/realms/medrule

# Registered OIDC Client ID for MedRule Web Application
OIDC_CLIENT_ID=medrule-web-client

# Confidential Client Secret (leave empty for public PKCE clients)
OIDC_CLIENT_SECRET=your-oidc-client-secret-placeholder

# Expected Audience (aud) claim in OIDC access and ID tokens
OIDC_AUDIENCE=medrule-api

# OIDC JSON Web Key Set (JWKS) URL for asymmetric signature verification (RS256)
OIDC_JWKS_URL=https://auth.example.com/realms/medrule/protocol/openid-connect/certs

# Fail-Closed Safety: When true, any missing IdP configuration in production
# immediately blocks all protected routes with 503 / 401 rather than bypassing auth.
FAIL_CLOSED_ON_MISSING_IDP=true

# ------------------------------------------------------------------------------
# 3. JWT & Cryptographic Session Security
# ------------------------------------------------------------------------------
# High-entropy signing secret (minimum 32 random characters) for HS256 / internal tokens
JWT_SECRET_KEY=change-this-to-a-secure-random-32-char-secret-key-in-production

# JWT Algorithm (HS256 for symmetric key, RS256 for OIDC IdP verification)
JWT_ALGORITHM=HS256

# Access Token lifetime in minutes
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# ------------------------------------------------------------------------------
# 4. Browser Session Cookie Security
# ------------------------------------------------------------------------------
# Set to 'true' in staging/production to require HTTPS transmission (Secure flag)
# Set to 'false' only for local localhost development without HTTPS.
COOKIE_SECURE=false

# SameSite cookie policy ('lax' or 'strict' recommended for CSRF mitigation)
COOKIE_SAMESITE=lax

# Cookie Domain scope (e.g. '.example.com' or leave empty for host-only)
COOKIE_DOMAIN=

# ------------------------------------------------------------------------------
# 5. Cross-Site Request Forgery (CSRF) Protection
# ------------------------------------------------------------------------------
# High-entropy HMAC secret for CSRF token generation and verification
CSRF_SECRET_KEY=change-this-to-a-secure-random-csrf-secret-key-in-production

# ------------------------------------------------------------------------------
# 6. Cross-Origin Resource Sharing (CORS)
# ------------------------------------------------------------------------------
# Comma-separated list of allowed frontend origins (no trailing slashes)
# In production, specify exact domain(s) such as 'https://app.medrule.health'
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ------------------------------------------------------------------------------
# 7. Clinical Governance & Audit Flags
# ------------------------------------------------------------------------------
# DEVELOPMENT_MODE must remain true until genuine multi-specialty clinical sign-offs
# and real policy validation are completed. Real-patient authorization is strictly BLOCKED.
DEVELOPMENT_MODE=true

# ------------------------------------------------------------------------------
# 8. Groq AI Interactive Agent Copilot
# ------------------------------------------------------------------------------
# Obtain fast Groq API key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_API_BASE=https://api.groq.com/openai/v1
